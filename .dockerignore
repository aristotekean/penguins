# Git
.git/
.gitignore

# Docker files (never needed inside the image)
.dockerignore
Dockerfile
docker-compose*.yml

# Virtual environments (dependencies are installed with uv during the build)
.venv/
venv/
ENV/

# Python caches at any depth. Note: .dockerignore patterns without **/ only
# match at the root of the build context, unlike .gitignore.
**/__pycache__
**/*.py[cod]

# Jupyter checkpoints (notebooks/ itself IS copied by the jupyter target)
**/.ipynb_checkpoints

# Tests and coverage
tests/
**/.pytest_cache
.coverage
htmlcov/

# Editors / IDEs
.vscode/
.idea/

# OS and tooling metadata
.DS_Store
.atl/

# Environment variables and secrets
.env
.env.*

# Trained models are served from the shared volume, not baked into the image
models/
**/*.pkl
**/*.joblib
**/*.onnx

# Logs
**/*.log

# Documentation not needed at runtime
README.md
docs/
